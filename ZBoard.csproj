<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net10.0-android</TargetFramework>
    <SupportedOSPlatformVersion>26</SupportedOSPlatformVersion>
    <OutputType>Exe</OutputType>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <RootNamespace>ZBoard</RootNamespace>
    <AssemblyName>ZBoard</AssemblyName>

    <ApplicationId>de.World_of_Bytes.zBoard</ApplicationId>
    <ApplicationTitle>zBoard</ApplicationTitle>
    <ApplicationVersion>17</ApplicationVersion>
    <ApplicationDisplayVersion>0.12.0</ApplicationDisplayVersion>
  </PropertyGroup>

  <!-- Testprojekt und Werkzeuge gehören nicht in die App -->
  <ItemGroup>
    <Compile Remove="tests/**" />
    <None Remove="tests/**" />
    <Compile Remove="tools/**" />
    <None Remove="tools/**" />
    <Compile Remove="plugin-apps/**" />
    <None Remove="plugin-apps/**" />
    <AndroidResource Remove="plugin-apps/**" />
    <None Remove="signing/**" />
  </ItemGroup>

  <!--
    Testhaken (Tastenpositionen im Log, Testfeld-Activity) für den Emulator-Test. In Debug immer an; ein
    Release-Build bekommt sie nur mit -p:ZBoardTestHooks=true (Prüfung der AOT-Version im Emulator), nie im Store-Build.
  -->
  <PropertyGroup Condition="'$(ZBoardTestHooks)' == 'true'">
    <DefineConstants>$(DefineConstants);ZBOARD_TESTHOOKS</DefineConstants>
  </PropertyGroup>

  <!-- Debug/Testversionen immer mit demselben Testschlüssel signieren, damit Updates installierbar sind -->
  <PropertyGroup Condition="'$(Configuration)' == 'Debug' Or '$(ZBoardTestHooks)' == 'true'">
    <AndroidKeyStore>true</AndroidKeyStore>
    <AndroidSigningKeyStore>$(MSBuildThisFileDirectory)signing/zboard-test.keystore</AndroidSigningKeyStore>
    <AndroidSigningStorePass>zboard-test</AndroidSigningStorePass>
    <AndroidSigningKeyAlias>zboard-test</AndroidSigningKeyAlias>
    <AndroidSigningKeyPass>zboard-test</AndroidSigningKeyPass>
  </PropertyGroup>

  <!--
    Release: AOT für schnellen Start, App-Bundle (.aab) für Google Play und APK zum direkten Installieren.
    Signiert wird mit dem Upload-Schlüssel aus den Repository-Secrets (siehe .github/workflows/build.yml):
    -p:AndroidSigningKeyStore=… -p:AndroidSigningStorePass=… -p:AndroidSigningKeyAlias=… -p:AndroidSigningKeyPass=…
  -->
  <PropertyGroup Condition="'$(Configuration)' == 'Release'">
    <AndroidPackageFormats>aab;apk</AndroidPackageFormats>
    <RunAOTCompilation>true</RunAOTCompilation>
    <AndroidEnableProfiledAot>true</AndroidEnableProfiledAot>
    <AndroidKeyStore>true</AndroidKeyStore>
  </PropertyGroup>

</Project>
