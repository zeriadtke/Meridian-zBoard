<Project Sdk="Microsoft.NET.Sdk">

  <!-- zBoard DeepL: Plugin-App für zBoard. Eigene App, damit nur sie Internet braucht – zBoard bleibt offline. -->
  <PropertyGroup>
    <TargetFramework>net10.0-android</TargetFramework>
    <SupportedOSPlatformVersion>26</SupportedOSPlatformVersion>
    <OutputType>Exe</OutputType>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <RootNamespace>ZBoard.DeepL</RootNamespace>
    <AssemblyName>ZBoard.DeepL</AssemblyName>

    <ApplicationId>de.World_of_Bytes.zBoard.DeepL</ApplicationId>
    <ApplicationTitle>zBoard DeepL</ApplicationTitle>
    <ApplicationVersion>2</ApplicationVersion>
    <ApplicationDisplayVersion>1.1</ApplicationDisplayVersion>
  </PropertyGroup>

  <!-- Gemeinsamer Vertrag mit zBoard -->
  <ItemGroup>
    <Compile Include="../../Plugins/PluginContract.cs" Link="Contract/PluginContract.cs" />
  </ItemGroup>

  <!-- Debug wie zBoard mit dem Testschlüssel signieren (zBoard zeigt dann "vom selben Entwickler") -->
  <PropertyGroup Condition="'$(Configuration)' == 'Debug'">
    <AndroidKeyStore>true</AndroidKeyStore>
    <AndroidSigningKeyStore>$(MSBuildThisFileDirectory)../../signing/zboard-test.keystore</AndroidSigningKeyStore>
    <AndroidSigningStorePass>zboard-test</AndroidSigningStorePass>
    <AndroidSigningKeyAlias>zboard-test</AndroidSigningKeyAlias>
    <AndroidSigningKeyPass>zboard-test</AndroidSigningKeyPass>
  </PropertyGroup>

  <!-- Release für Google Play: Upload-Schlüssel per -p:AndroidSigningKeyStore=… usw. übergeben -->
  <PropertyGroup Condition="'$(Configuration)' == 'Release'">
    <AndroidPackageFormats>aab;apk</AndroidPackageFormats>
  </PropertyGroup>

</Project>
