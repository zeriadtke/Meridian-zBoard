<Project Sdk="Microsoft.NET.Sdk">

  <!--
    Misst, wie lange das Laden der Wörterbücher und Sprachmodelle dauert und wie viel Speicher es braucht, und
    die Rechenzeit je Tastendruck beim Tippen
    (Aufruf: siehe Kopf von Program.cs). Dieselben Quelltexte wie die App, ohne weitere Pakete.
  -->
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <RootNamespace>ZBoard.Tools.LoadBench</RootNamespace>
    <InvariantGlobalization>true</InvariantGlobalization>
  </PropertyGroup>

  <ItemGroup>
    <Compile Include="../../Keyboard/KeyboardLayout.cs" Link="Core/KeyboardLayout.cs" />
    <Compile Include="../../Keyboard/Layouts.cs" Link="Core/Layouts.cs" />
    <Compile Include="../../Suggestions/WordDictionary.cs" Link="Core/WordDictionary.cs" />
    <Compile Include="../../Suggestions/KeyProximity.cs" Link="Core/KeyProximity.cs" />
    <Compile Include="../../Suggestions/SuggestionEngine.cs" Link="Core/SuggestionEngine.cs" />
    <Compile Include="../../Suggestions/NgramModel.cs" Link="Core/NgramModel.cs" />
    <Compile Include="../../Suggestions/NeuralModel.cs" Link="Core/NeuralModel.cs" />
    <Compile Include="../../Suggestions/TouchTrace.cs" Link="Core/TouchTrace.cs" />
    <Compile Include="../../Suggestions/UserHistory.cs" Link="Core/UserHistory.cs" />
    <Compile Include="../../Suggestions/GlideDecoder.cs" Link="Core/GlideDecoder.cs" />
    <Compile Include="../../Suggestions/MultilingualEngine.cs" Link="Core/MultilingualEngine.cs" />
  </ItemGroup>

</Project>
