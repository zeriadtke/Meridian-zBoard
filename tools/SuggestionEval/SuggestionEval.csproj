<Project Sdk="Microsoft.NET.Sdk">

  <!--
    Misst die Qualität von Wortvorschlägen und Autokorrektur mit simuliertem Tippen (Aufruf: siehe README.md).
    Benutzt dieselben Quelltexte wie die App und die Unit-Tests, ohne weitere Pakete.
  -->
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <RootNamespace>ZBoard.Tools.SuggestionEval</RootNamespace>
    <InvariantGlobalization>true</InvariantGlobalization>
  </PropertyGroup>

  <ItemGroup>
    <Compile Include="../../Keyboard/KeyboardLayout.cs" Link="Core/KeyboardLayout.cs" />
    <Compile Include="../../Keyboard/Layouts.cs" Link="Core/Layouts.cs" />
    <Compile Include="../../Suggestions/WordDictionary.cs" Link="Core/WordDictionary.cs" />
    <Compile Include="../../Suggestions/KeyProximity.cs" Link="Core/KeyProximity.cs" />
    <Compile Include="../../Suggestions/SuggestionEngine.cs" Link="Core/SuggestionEngine.cs" />
    <Compile Include="../../Suggestions/NgramModel.cs" Link="Core/NgramModel.cs" />
    <Compile Include="../../Suggestions/TouchTrace.cs" Link="Core/TouchTrace.cs" />
    <Compile Include="../../Suggestions/UserHistory.cs" Link="Core/UserHistory.cs" />
    <Compile Include="../../Suggestions/GlideDecoder.cs" Link="Core/GlideDecoder.cs" />
  </ItemGroup>

</Project>
